# Database (required)
DATABASE_URL=mysql://username:password@host:port/database

# Local Auth JWT Secret (required - generate a strong random string)
LOCAL_AUTH_SECRET=your-super-secret-jwt-key-here

# OAuth credentials (from your Kimi app settings)
VITE_KIMI_AUTH_URL=https://your-auth-url
VITE_APP_ID=your-app-id
APP_SECRET=your-app-secret

# Telegram Bot (optional - for trade notifications)
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
